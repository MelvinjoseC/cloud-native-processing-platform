      "title": "RabbitMQ Queue Backlog vs DLQ",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rabbitmq_queue_messages{queue=\"tasks\"}",
