{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values",
  "type": "object",
  "required": ["global", "secrets", "producer", "worker", "rabbitmq", "redis"],
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string"
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["rabbitmqUser", "rabbitmqPass", "redisPassword"],
      "properties": {
        "rabbitmqUser": {
          "type": "string"
        },
        "rabbitmqPass": {
          "type": "string"
        },
        "redisPassword": {
          "type": "string"
        }
      }
    },
    "producer": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 30
        },
        "keda": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 0
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "queueLengthTriggerValue": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "rabbitmq": {
      "type": "object",
      "properties": {
        "persistence": {
          "type": "object"
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "persistence": {
          "type": "object"
        }
      }
    },
    "resilience": {
      "type": "object",
      "properties": {
        "pdb": {
          "type": "object"
        },
        "networkPolicy": {
          "type": "object"
        }
      }
    }
  }
}
